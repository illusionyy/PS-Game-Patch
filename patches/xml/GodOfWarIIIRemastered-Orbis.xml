    <Metadata Title="God of War III Remastered" 
              Name="3840x2160 (4K)" 
              Note="Forces 3840x2160 rendering. Expands video arena to 2272 MiB and reduces general heap to 1888 MiB to prevent direct memory exhaustion. Native 4K output on PS5 backwards compatibility requires NeoEnabler." 
              Author="cuesta4, kvicken" 
              PatchVer="1.0" 
              AppVer="01.02" 
              AppElf="eboot.bin">
        <PatchList>
            <!-- 3840x2160 render targets and half-res buffers -->
            <Line Type="bytes" Address="0x005f0c5b" Value="000f0000"/>
            <Line Type="bytes" Address="0x005f0c63" Value="70080000"/>
            <Line Type="bytes" Address="0x005f0c6c" Value="000f"/>
            <Line Type="bytes" Address="0x005f0c73" Value="7008"/>
            <Line Type="bytes" Address="0x005643e3" Value="70080000"/>
            <Line Type="bytes" Address="0x005643f0" Value="000f0000"/>
            <Line Type="bytes" Address="0x005ff889" Value="000f0000"/>
            <Line Type="bytes" Address="0x005ff88f" Value="70080000"/>
            <Line Type="bytes" Address="0x007c46b4" Value="000f0000"/>
            <Line Type="bytes" Address="0x007c46b8" Value="70080000"/>
            <Line Type="bytes" Address="0x0056bb72" Value="70080000"/>
            <Line Type="bytes" Address="0x0060965d" Value="70080000"/>
            <Line Type="bytes" Address="0x007f2a3c" Value="80070000"/>
            <Line Type="bytes" Address="0x007f2a40" Value="38040000"/>

            <!-- Video arena: 1280 MiB -> 2272 MiB (0x8e) -->
